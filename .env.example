# Kopirajte u .env.local i upišite podatke iz Supabase projekta
# (Supabase → Project Settings → API). Bez ovoga aplikacija radi samo lokalno.
# U VITE_SUPABASE_ANON_KEY ide "publishable" ključ (sb_publishable_...) ili stari "anon" ključ.
# NIKAD ne upisujte "secret" (sb_secret_...) ni "service_role" ključ – on zaobilazi svu zaštitu.
VITE_SUPABASE_URL=https://VAS-PROJEKAT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
